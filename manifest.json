{
    "manifest_version": 3,

    "name": "__MSG_extName__",
    "short_name": "__MSG_extName__",
    "version": "1.6.0",
    "description": "__MSG_extDesc__",

    "default_locale": "en",

    "minimum_chrome_version": "126",

    "browser_specific_settings": {
        "gecko": {
            "id": "@snsmediadownloader-tail4126",
            "data_collection_permissions": { "required": ["none"] },
            "strict_min_version": "140.0"
        }
    },

    "icons": {
        "16": "icons/16.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    },

    "host_permissions": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://bsky.app/*",
        "https://public.api.bsky.app/*",
        "https://plc.directory/*",
        "https://poipiku.com/*",
        "https://cdn.poipiku.com/*",
        "https://privatter.net/*",
        "https://privatter.me/*",
        "https://skeb.jp/*",
        "https://seiga.nicovideo.jp/*",
        "https://manga.nicovideo.jp/*",
        "https://lohas.nicoseiga.jp/*"
    ],

    "content_scripts": [
        {
            "matches": [
                "https://x.com/*",
                "https://twitter.com/*"
            ],
            "js": [
                "sites/x/interceptor.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://x.com/*",
                "https://twitter.com/*"
            ],
            "js": [
                "shared/core.js",
                "sites/x/content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://bsky.app/*"
            ],
            "js": [
                "shared/core.js",
                "sites/bluesky/content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://poipiku.com/*"
            ],
            "js": [
                "shared/core.js",
                "sites/poipiku/content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://privatter.net/i/*",
                "https://privatter.net/p/*"
            ],
            "js": [
                "shared/core.js",
                "sites/privatter/content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://privatter.me/page/*"
            ],
            "js": [
                "shared/core.js",
                "sites/privatterplus/content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://skeb.jp/*"
            ],
            "js": [
                "shared/core.js",
                "sites/skeb/content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://seiga.nicovideo.jp/seiga/im*",
                "https://manga.nicovideo.jp/watch/mg*"
            ],
            "js": [
                "shared/core.js",
                "sites/niconico/content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_end"
        }
    ],

    "background": {
        "service_worker": "background.js",
        "scripts": [ "shared/template.js", "background.js" ]
    },

    "action": {
        "default_popup": "popup.html"
    },

    "options_ui": {
        "page": "popup.html",
        "open_in_tab": true
    },

    "permissions": [
        "alarms",
        "downloads",
        "storage"
    ]
}
